# MCP 服务
MCP_PORT=3100
MCP_HOST=0.0.0.0
MCP_PATH=/mcp
# 远程 Agent 连接 MCP 时使用的 Bearer Token（自行生成高强度随机串）
MCP_AUTH_TOKEN=change-me-mcp-bearer-token
# 绑定 0.0.0.0 时可选：允许的 Host 头，逗号分隔
# MCP_ALLOWED_HOSTS=mcp.example.com,localhost

# 集成中台
INTEGRATION_BASE_URL=http://127.0.0.1:8080
# 调用中台 REST 的 API Key（与中台 ApiKeyAuthFilter 约定一致；内网联调可先用占位值）
INTEGRATION_API_KEY=change-me-integration-api-key